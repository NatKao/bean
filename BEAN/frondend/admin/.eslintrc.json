{
  "env": {
    "browser": true,
    "es2021": true,
    "jquery": true
  },
  "extends": [
    "plugin:vue/vue3-recommended",
    "airbnb-base",
    "plugin:prettier/recommended",
    "plugin:jsdoc/recommended"
  ],
  "globals": { "Atomics": "readonly", "SharedArrayBuffer": "readonly" },
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "plugins": ["vue", "prettier", "jsdoc"],
  "rules": {
    "prettier/prettier": "warn",
    "jsdoc/require-jsdoc": [
      "warn",
      {
        "contexts": [
          // 變數為回傳[箭頭函式]時
          "VariableDeclarator:has(VariableDeclarator[init.body.type = ArrowFunctionExpression]) > ArrowFunctionExpression",
          // 變數內容不為Import且為[箭頭函式]時
          "VariableDeclarator:not(VariableDeclarator[init.body.type = ImportExpression]):has(VariableDeclarator[init.type = ArrowFunctionExpression]) > ArrowFunctionExpression",
          // 變數為[箭頭函式]回傳結果時
          "VariableDeclarator:has(VariableDeclarator[init.body.type = Literal]) > ArrowFunctionExpression",
          // 變數為 [函式] 時
          "VariableDeclarator:has(VariableDeclarator[init.type = FunctionExpression]) > FunctionExpression"
        ]
      }
    ],
    "jsdoc/require-asterisk-prefix": "warn",
    "jsdoc/require-description": "warn",
    "jsdoc/sort-tags": "warn",
    "linebreak-style": "off",
    "indent": "off",
    "newline-per-chained-call": "off",
    "ignoreChainWithDepth": "off",
    "no-tabs": "off",
    "quote-props": "off",
    "no-var": "warn",
    "vars-on-top": "off",
    "no-alert": "off",
    "no-undef": "off",
    "import/no-unresolved": "off",
    "import/extensions": "off",
    "no-param-reassign": ["error", { "props": false }],
    "comma-dangle": ["error", "never"],
    "no-unused-vars": ["error", { "args": "none" }],
    "arrow-parens": ["error", "as-needed"],
    "no-trailing-spaces": "off",
    "no-irregular-whitespace": "off",
    "no-use-before-define": "off",
    "import/order": "off",
    "camelcase": "off",
    "prefer-template": "off",
    "prefer-destructuring": "off",
    "spaced-comment": "off",
    "func-names": "off",
    "import/no-extraneous-dependencies": "off",
    "dot-notation": "warn",
    "eqeqeq": ["off", "smart"],
    "yoda": "off",
    "no-underscore-dangle": "off",
    "no-plusplus": ["error", { "allowForLoopAfterthoughts": true }],
    "object-shorthand": "warn",
    "no-restricted-globals": "off",
    "prefer-const": "warn",
    "no-shadow": ["error", { "allow": ["state"] }],
    "no-continue": "off",
    "vue/no-side-effects-in-computed-properties": "warn",
    "no-unneeded-ternary": "warn",
    "no-useless-escape": "off",
    "vue/component-definition-name-casing": ["error", "PascalCase"],
    "vue/no-v-for-template-key": "off",
    "vue/no-multiple-template-root": "off",
    "vue/comment-directive": "off",
    "object-curly-newline": "off",
    "vue/attribute-hyphenation": "off",
    "vue/component-options-name-casing": ["error", "PascalCase"],
    "vue/component-name-in-template-casing": [
      "error",
      "PascalCase",
      {
        "registeredComponentsOnly": true,
        "ignores": ["/^q-/", "/^router-/"]
      }
    ],
    "vue/v-on-event-hyphenation": "off"
  }
}
